# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=

# Auth — REQUIRED in production. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# ACCESS_TOKEN_TTL_HOURS=12

# CORS: origin of the Next.js frontend
# FRONTEND_ORIGIN=http://localhost:3000

# Optional: override the default SQLite database
# DATABASE_URL=sqlite:///./campaigns.db
